# Copy to .env for docker compose (optional — AI keys can also be set in the Streamlit UI)
APP_VERSION=2.0
JOB_DB_PATH=/app/data/jobs.db

# Shared persistent database (local + cloud).
# Set this to the Azure PostgreSQL connection string so local runs use the same
# store as the Container App. sslmode=require is added automatically for Azure
# if omitted.
DATABASE_URL=

# Gemini / OpenAI-compatible AI recommendations
AI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash

# Job ingestion API (optional)
JOB_API_KEY=https://www.arbeitnow.com/api/job-board-api
API_JOB_LIMIT=500

# JSearch (RapidAPI) — IT job harvesting. Free plan ≈200 requests/month.
# Used by testing/scripts/harvest_jobs_jsearch.py and the "JSearch (IT jobs)" ingestion source.
JSEARCH_API_KEY=
